<Window
    x:Class="ImzaKit.Hosts.Desktop.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ImzaKit Desktop">
    <Grid Padding="28" Background="#FBFDFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock FontSize="28" FontWeight="Bold" Foreground="#073B4C" Text="ImzaKit Desktop"/>
            <TextBlock Margin="0,6,0,0" Foreground="#526B73" TextWrapping="Wrap"
                       Text="PDF seçin, kart sertifikasını seçin, PIN’i Windows penceresinde girin. PIN bu ekrana yazılmaz."/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock FontWeight="SemiBold" Foreground="#073B4C" Text="1. PDF"/>
            <Button x:Name="PickPdfButton" Margin="0,8,0,0" Click="PickPdfButton_Click" Content="PDF seç"/>
            <TextBlock x:Name="FilePathText" Margin="0,8,0,0" Foreground="#526B73" TextWrapping="Wrap"/>
            <TextBlock x:Name="HashText" Margin="0,4,0,0" FontFamily="Consolas" FontSize="12" Foreground="#087C7D" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock FontWeight="SemiBold" Foreground="#073B4C" Text="2. Sertifika"/>
            <Button x:Name="RefreshButton" Margin="0,8,0,8" Click="RefreshButton_Click" Content="Kartı yenile"/>
            <ListView x:Name="CertificateList" MaxHeight="160" SelectionChanged="CertificateList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Subject}"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <TextBlock FontWeight="SemiBold" Foreground="#073B4C" Text="3. İmzala"/>
            <Button x:Name="SignButton" Margin="0,8,0,0" Click="SignButton_Click" Content="İmzala"/>
        </StackPanel>
        <StackPanel Grid.Row="4">
            <TextBlock FontWeight="SemiBold" Foreground="#073B4C" Text="4. Sonuç"/>
            <TextBlock x:Name="ErrorText" Margin="0,8,0,0" Foreground="#B42318" TextWrapping="Wrap"/>
            <TextBlock x:Name="TrustText" Margin="0,8,0,0" Foreground="#087C7D" TextWrapping="Wrap"/>
            <HyperlinkButton x:Name="DownloadLink" Margin="0,8,0,0" Click="DownloadLink_Click" Content="İmzalı PDF’i indir"/>
            <Button x:Name="ShowFolderButton" Margin="0,8,0,0" Click="ShowFolderButton_Click" Content="Klasörde göster"/>
        </StackPanel>
    </Grid>
</Window>
